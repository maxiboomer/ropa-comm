<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent template: cloudflared (Cloudflare Tunnel quick mode)
  Copy para: ~/Library/LaunchAgents/ropa.tunnel.plist
  Substituir {{HOME}} pelo caminho real.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ropa.tunnel</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>{{HOME}}/Library/Application Support/ropa/start-tunnel.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>15</integer>

    <key>StandardOutPath</key>
    <string>{{HOME}}/Library/Application Support/ropa/logs/cloudflared-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>{{HOME}}/Library/Application Support/ropa/logs/cloudflared-stderr.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
